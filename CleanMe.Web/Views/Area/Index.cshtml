@using CleanMe.Web.Helpers
@using CleanMe.Application.Helpers.Paging
@model PagedResult<CleanMe.Application.ViewModels.AreaIndexViewModel>

@{
    ViewData["Title"] = "Area List";
    string sortOrder = ViewBag.SortOrder as string ?? "ASC";
    string sortColumn = ViewBag.SortColumn as string ?? "AreaName";
}

<h2>Area List</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<!-- Add Button (Top-Right) -->
<!-- <div class="text-end mb-3">
    <a asp-action="AddEdit" class="btn btn-primary">Add Area</a>
</div> -->

<!-- Filtering Form -->
<form method="get" id="filterForm">
    <div class="table-responsive">
        <table class="table table-striped w-100 table-fixed">
            <thead>
                <!-- Column Headers with Sorting -->
                <tr>
                    <th>
                        <a href="#" onclick="sortTable('RegionName')">
                            Region @Html.Raw(HtmlHelpers.GetSortIcon(ViewContext, "RegionName"))
                        </a>
                    </th>
                    <th>
                        <a href="#" onclick="sortTable('AreaName')">
                            Area @Html.Raw(HtmlHelpers.GetSortIcon(ViewContext, "AreaName"))
                        </a>
                    </th>
                    <th>
                        <a href="#" onclick="sortTable('CleanerName')">
                            Cleaner @Html.Raw(HtmlHelpers.GetSortIcon(ViewContext, "CleanerName"))
                        </a>
                    </th>
                    <th>
                        <a href="#" onclick="sortTable('ReportCode')">
                            Report Code @Html.Raw(HtmlHelpers.GetSortIcon(ViewContext, "ReportCode"))
                        </a>
                    </th>
                    <th>
                        <a href="#" onclick="sortTable('IsActive')">
                            Active @Html.Raw(HtmlHelpers.GetSortIcon(ViewContext, "IsActive"))
                        </a>
                    </th>
                    <th>Actions</th>
                </tr>

                <!-- Filter Row -->
                <tr>
                    <td><input type="text" name="regionName" class="form-control" value="@ViewBag.RegionName" placeholder="Search Region"></td>
                    <td><input type="text" name="areaName" class="form-control" value="@ViewBag.AreaName" placeholder="Search Area"></td>
                    <td><input type="text" name="cleanerName" class="form-control" value="@ViewBag.CleanerName" placeholder="Search Cleaner"></td>
                    <td><input type="text" name="reportCode" class="form-control" value="@ViewBag.ReportCode" placeholder="Search Report Code"></td>
                    <td>
                        <select name="isActive" class="form-control">
                            <option value="">All</option>
                            <option value="1" selected="@(ViewBag.IsActive == "1" ? "selected" : null)">Active</option>
                            <option value="0" selected="@(ViewBag.IsActive == "0" ? "selected" : null)">Inactive</option>
                        </select>
                    </td>
                    <td>
                        <button type="submit" class="btn btn-success">Filter</button>
                        <a href="@Url.Action("Index", "Area")" class="btn btn-secondary">Clear</a>
                    </td>
                </tr>
            </thead>
            <tbody>
                @foreach (var Area in Model.Items)
                {
                    <tr>
                        <td class="ps-4">@Area.RegionName</td>
                        <td class="ps-4">@Area.AreaName</td>
                        <td class="ps-4">@Area.CleanerName</td>
                        <td class="ps-4">@Area.ReportCode</td>
                        <td class="ps-4">@(Area.IsActive ? "Yes" : "No")</td>
                        <td class="ps-4">
                            <a asp-action="AddEdit" asp-route-areaId="@Area.areaId" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-areaId="@Area.areaId" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @await Html.PartialAsync(
        "_IndexFooterPager",
                new CleanMe.Application.Helpers.Paging.PagedResult<object>
                {
                    PageNumber = Model.PageNumber,
                    PageSize = Model.PageSize,
                    TotalCount = Model.TotalCount
                }
                )
    </div>
</form>

<!-- JavaScript for Sorting -->
@section Scripts {
    <script src="~/js/shared/index-view-sort-table.js"></script>
}
