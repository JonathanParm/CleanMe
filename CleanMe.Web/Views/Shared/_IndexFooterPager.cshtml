@using Microsoft.AspNetCore.Http.Extensions
@using CleanMe.Application.Helpers.Paging
@model PagedResult<object>

@{
    var query = Context.Request.Query
        .ToDictionary(k => k.Key, v => v.Value.ToString());
}

<nav class="d-flex justify-content-between align-items-center mt-3">

    <!-- LEFT: Page size -->
    <form method="get" class="d-flex align-items-center gap-2">
        <label class="mb-0">Page size</label>

        @* Preserve existing querystring values *@
        @foreach (var q in query)
        {
            if (q.Key != "pageSize" && q.Key != "pageNumber")
            {
                <input type="hidden" name="@q.Key" value="@q.Value" />
            }
        }

        <select name="pageSize"
                class="form-select form-select-sm w-auto"
                onchange="this.form.submit()">

            <option value="5" selected="@(Model.PageSize == 5)">5</option>
            <option value="10" selected="@(Model.PageSize == 10)">10</option>
            <option value="20" selected="@(Model.PageSize == 20)">20</option>
            <option value="50" selected="@(Model.PageSize == 50)">50</option>
            <option value="100" selected="@(Model.PageSize == 100)">100</option>
        </select>
    </form>

    <!-- CENTER: Page info -->
    <div>
        Page @Model.PageNumber of @Model.TotalPages
        (@Model.TotalCount records)
    </div>

    <!-- RIGHT: Arrows -->
    <ul class="pagination mb-0">

        <li class="page-item @(Model.PageNumber > 1 ? "" : "disabled")">
            <a class="page-link"
               href="@(Model.PageNumber > 1 ? BuildUrl(1) : "#")"
               aria-disabled="@(Model.PageNumber > 1 ? "false" : "true")"
               tabindex="@(Model.PageNumber > 1 ? "0" : "-1")">
                &laquo;&laquo;
            </a>
        </li>

        <li class="page-item @(Model.HasPrevious ? "" : "disabled")">
            <a class="page-link"
               href="@(Model.HasPrevious ? BuildUrl(Model.PageNumber - 1) : "#")"
               aria-disabled="@(Model.HasPrevious ? "false" : "true")"
               tabindex="@(Model.HasPrevious ? "0" : "-1")">
                &laquo;
            </a>
        </li>

        <li class="page-item @(Model.HasNext ? "" : "disabled")">
            <a class="page-link"
               href="@(Model.HasNext ? BuildUrl(Model.PageNumber + 1) : "#")"
               aria-disabled="@(Model.HasNext ? "false" : "true")"
               tabindex="@(Model.HasNext ? "0" : "-1")">
                &raquo;
            </a>
        </li>

        <li class="page-item @(Model.PageNumber < Model.TotalPages ? "" : "disabled")">
            <a class="page-link"
               href="@(Model.PageNumber < Model.TotalPages ? BuildUrl(Model.TotalPages) : "#")"
               aria-disabled="@(Model.PageNumber < Model.TotalPages ? "false" : "true")"
               tabindex="@(Model.PageNumber < Model.TotalPages ? "0" : "-1")">
                &raquo;&raquo;
            </a>
        </li>

    </ul>
</nav>

@functions {
    string BuildUrl(int page)
    {
        var q = Context.Request.Query
            .ToDictionary(k => k.Key, v => v.Value.ToString());

        var total = Model.TotalPages < 1 ? 1 : Model.TotalPages;
        page = Math.Clamp(page, 1, total);

        q["pageNumber"] = page.ToString();

        return QueryString.Create(q).ToUriComponent();
    }
}