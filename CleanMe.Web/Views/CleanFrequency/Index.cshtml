@using CleanMe.Web.Helpers
@using CleanMe.Application.Helpers.Paging
@model PagedResult<CleanMe.Application.ViewModels.CleanFrequencyIndexViewModel>

@{
    ViewData["Title"] = "Clean Frequency List";
    string sortOrder = ViewBag.SortOrder as string ?? "ASC";
    string sortColumn = ViewBag.SortColumn as string ?? "CleanFrequencyName";
}

<h2>Clean Frequency List</h2>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">
        @TempData["SuccessMessage"]
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">
        @TempData["ErrorMessage"]
    </div>
}

<!-- Add Button (Top-Right) -->
<div class="text-end mb-3">
    <a asp-action="AddEdit" class="btn btn-primary">Add Clean Frequency</a>
</div>

<!-- Filtering Form -->
<form method="get" id="filterForm">
    <div class="table-responsive">
        <table class="table table-striped w-100 table-fixed">
            <thead>
                <!-- Column Headers with Sorting -->
                <tr>
                    <th>
                        <a href="#" onclick="sortTable('CleanFrequencyName')">
                            Clean Frequency @Html.Raw(HtmlHelpers.GetSortIcon(ViewContext, "CleanFrequencyName"))
                        </a>
                    </th>
                    <th>
                        <a href="#" onclick="sortTable('Description')">
                            Description @Html.Raw(HtmlHelpers.GetSortIcon(ViewContext, "Description"))
                        </a>
                    </th>
                    <th>
                        <a href="#" onclick="sortTable('Code')">
                            Code @Html.Raw(HtmlHelpers.GetSortIcon(ViewContext, "Code"))
                        </a>
                    </th>
                    <th>
                        <a href="#" onclick="sortTable('IsActive')">
                            Active @Html.Raw(HtmlHelpers.GetSortIcon(ViewContext, "IsActive"))
                        </a>
                    </th>
                    <th>Actions</th>
                </tr>

                <!-- Filter Row -->
                <tr>
                    <td><input type="text" name="cleanFrequencyName" class="form-control" value="@ViewBag.CleanFrequencyName" placeholder="Search Clean Frequency"></td>
                    <td><input type="text" name="description" class="form-control" value="@ViewBag.Description" placeholder="Search Description"></td>
                    <td><input type="text" name="code" class="form-control" value="@ViewBag.Code" placeholder="Search Code"></td>
                    <td>
                        <select name="isActive" class="form-control">
                            <option value="">All</option>
                            <option value="1" selected="@(ViewBag.IsActive == "1" ? "selected" : null)">Active</option>
                            <option value="0" selected="@(ViewBag.IsActive == "0" ? "selected" : null)">Inactive</option>
                        </select>
                    </td>
                    <td>
                        <button type="submit" class="btn btn-success">Filter</button>
                        <a href="@Url.Action("Index", "CleanFrequency")" class="btn btn-secondary">Clear</a>
                    </td>
                </tr>
            </thead>
            <tbody>
                @foreach (var CleanFrequency in Model.Items)
                {
                    <tr>
                        <td class="ps-4">@CleanFrequency.CleanFrequencyName</td>
                        <td class="ps-4">@CleanFrequency.Description</td>
                        <td class="ps-4">@CleanFrequency.Code</td>
                        <td class="ps-4">@(CleanFrequency.IsActive ? "Yes" : "No")</td>
                        <td class="ps-4">
                            <a asp-action="AddEdit" asp-route-cleanFrequencyId="@CleanFrequency.cleanFrequencyId" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-cleanFrequencyId="@CleanFrequency.cleanFrequencyId" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        @await Html.PartialAsync(
        "_IndexFooterPager",
                new CleanMe.Application.Helpers.Paging.PagedResult<object>
                {
                    PageNumber = Model.PageNumber,
                    PageSize = Model.PageSize,
                    TotalCount = Model.TotalCount
                }
                )
    </div>
</form>

<!-- JavaScript for Sorting -->
@section Scripts {
    <script src="~/js/shared/index-view-sort-table.js"></script>
}
