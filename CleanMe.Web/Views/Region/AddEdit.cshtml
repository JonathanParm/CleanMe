@using CleanMe.Application.Helpers.Paging
@using CleanMe.Application.ViewModels
@using CleanMe.Domain.Enums
@using CleanMe.Shared.Helpers

@model CleanMe.Application.ViewModels.RegionWithAreasViewModel

@{
    ViewData["Title"] = Model.RegionViewModel.regionId == 0 ? "Add Region" : "Edit Region";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="AddEdit" method="post" id="RegionForm" novalidate>
    @Html.AntiForgeryToken()

    @Html.ValidationSummary(false, "", new { @class = "text-danger" })

    @Html.HiddenFor(m => m.RegionViewModel.PageNumber)
    @Html.HiddenFor(m => m.RegionViewModel.PageSize)
    @Html.HiddenFor(m => m.RegionViewModel.TotalCount)
    @Html.HiddenFor(m => m.RegionViewModel.regionId)

    @Html.LabeledTextBoxFor(model => model.RegionViewModel.RegionName)

    @Html.LabeledTextBoxFor(model => model.RegionViewModel.ReportCode)

    @Html.LabeledTextBoxFor(model => model.RegionViewModel.SortOrder)

    @Html.YesNoButtonsFor(model => model.RegionViewModel.IsActive)

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

<h3 class="mt-4">Areas</h3>

<!-- Add Area Button -->
<div class="text-start mb-3">
    <button type="button"
            class="btn btn-sm btn-primary"
            data-redirect="@Url.Action("AddEdit", "Area", new
            {
                        regionId = Model.RegionViewModel.regionId,
                        returnUrl = Url.Action("AddEdit", "Region", new { regionId = Model.RegionViewModel.regionId })
            })"
            data-form="RegionForm">
            ➕ Add Area
    </button>
</div>

<!-- Areas Table -->
<div class="table-responsive">
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>Area</th>
                <th>Report Code</th>
                <th>Active</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var area in Model.Areas)
            {
                <tr>
                    <td>@area.AreaName</td>
                    <td>@area.ReportCode</td>
                    <td>@(area.IsActive ? "Yes" : "No")</td>
                    <td>
                        <button type="button"
                                class="btn btn-sm btn-warning redirect-after-save"
                                data-redirect="@Url.Action("AddEdit", "Area", new
                                {
                                    areaId = area.areaId,
                                    regionId = Model.RegionViewModel.regionId,
                                    returnUrl = Url.Action("AddEdit", "Region", new { regionId = Model.RegionViewModel.regionId })
                                })"
                                data-form="RegionForm">
                                ✏️ Edit
                        </button>

                        <button type="button"
                                class="btn btn-sm btn-danger redirect-after-save"
                                data-redirect="@Url.Action("Delete", "Area", new
                                {
                                    areaId = area.areaId,
                                    regionId = Model.RegionViewModel.regionId,
                                    returnUrl = Url.Action("AddEdit", "Region", new { regionId = Model.RegionViewModel.regionId })
                                })"
                                data-form="RegionForm">
                                🗑 Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    @await Html.PartialAsync(
    "_PagerFooter",
        new CleanMe.Application.Helpers.Paging.PagerModel
        {
            PageNumber = Model.RegionViewModel.PageNumber,
            PageSize = Model.RegionViewModel.PageSize,
            TotalCount = Model.RegionViewModel.TotalCount,
            RouteValues = new Microsoft.AspNetCore.Routing.RouteValueDictionary
            {
                ["regionId"] = Model.RegionViewModel.regionId
            }
        },
        viewData: null
        )
</div>

@section Scripts {
    <script src="~/js/shared/redirect-on-submit.js"></script>
}